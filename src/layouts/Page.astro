---
/* The document around the page: head, the header with the sections, the foot.
 *
 * THE POLICY. GitHub Pages sets no headers of ours, so the Content-Security-
 * Policy is a <meta>. The page runs no script at all - script-src is 'self',
 * no inline script, no handler attribute - and everything it loads is this
 * origin too. test/site.test.mjs holds the page to it.
 *
 * THE HEADER. Two rows: Home, FAQ, Community & Support with LinkedIn and the
 * playground on the right; under it the sections of the current page, a row
 * that scrolls sideways on a narrow screen. No script anywhere. */
import "../styles/global.css";

interface Props { title: string; description: string; current?: "home" | "community" | "faq"; subnav?: [string, string][] }
const { title, description, current = "home", subnav } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join("; ");
/* the home page's sections, the second row of the header there */
export const sections: [string, string][] = [
  ["the-problem-it-answers", "Use cases"],
  ["when-to-use-it-and-when-not", "Where it fits"],
  ["what-you-keep", "Enterprise ready"],
  ["what-it-costs", "Cost"],
  ["where-it-runs", "Where it runs"],
  ["ai", "AI"],
  ["who-runs-it", "Who runs it"],
  ["how-to-evaluate-it-in-a-week", "Get started"],
];
const row = subnav ?? (current === "home" ? sections : []);
const home = base;
const community = `${base}community/`;
const faq = `${base}faq/`;
// the build date, so a reader knows how old the figures on the page are
const updated = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(`${base}og-image.png`, Astro.site).href}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="theme-color" content="#ffffff">
<link rel="icon" href={`${base}favicon.png`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
<link rel="preload" href={`${base}fonts/inter-roman-latin.woff2`} as="font" type="font/woff2" crossorigin>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap">
    <a class="mark" href="https://abap2ui5.github.io/"><img src={`${base}logo.png`} alt="" width="28" height="28"> abap2UI5</a>
    <nav class="nav" aria-label="Pages">
      <a href={home} aria-current={current === "home" ? "page" : undefined}>Home</a>
      <a href={faq} aria-current={current === "faq" ? "page" : undefined}>FAQ</a>
      <a href={community} aria-current={current === "community" ? "page" : undefined}>Community &amp; Support</a>
    </nav>
    <div class="top-actions">
      <a class="icon-btn" href="https://www.linkedin.com/company/abap2ui5" aria-label="abap2UI5 on LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4z"/></svg></a>
      <a class="btn btn-primary" href="https://abap2ui5.github.io/samples-site/">See it running</a>
    </div>
  </div>
  {row.length > 0 && (
    <nav class="subnav" aria-label="Sections">
      <div class="wrap">
        {row.map(([id, text]) => <a href={`#${id}`}>{text}</a>)}
      </div>
    </nav>
  )}
</header>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <span>abap2UI5 · MIT licensed · built in the open · page updated <time datetime={updated}>{updated}</time> · <a href="mailto:contact@abap2UI5.org">contact@abap2UI5.org</a></span>
    <nav aria-label="More">
      <a href="https://abap2ui5.github.io/docs/">Documentation</a>
      <a href="https://abap2ui5.github.io/samples-site/">Samples</a>
      <a href="https://abap2ui5.github.io/playground/">Playground</a>
      <a href="https://github.com/abap2UI5/abap2UI5">GitHub</a>
      <a href="https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email">Slack</a>
      <a href={faq}>FAQ</a>
      <a href={community}>Community &amp; Support</a>
      <a href="https://github.com/abap2UI5/why">Edit this page</a>
    </nav>
  </div>
</footer>
</body>
</html>
