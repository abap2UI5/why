---
/* The headline under the hero: what a decision maker takes away in five
 * seconds. Claims a reader can check, not counts of tests or specs - those
 * belong to the framework's README. The figures are from November 2026 and
 * link to their source in "Who runs it". */
const tiles = [
  ["0 €", "license fees, for any number of users, systems and apps"],
  ["1 class", "per app, a regular one: ATC, transport, unit test, the logic in ABAP"],
  ["7.02 → Cloud", "cloud ready: every SAP release, from one source"],
  ["2,900+", "systems pulled it from GitHub in two weeks, November 2026"],
  ["Since 2023", "open source on GitHub, MIT, every release listed"],
  ["25+", "contributors, from several companies"],
];
---
<div class="stats wrap" aria-label="abap2UI5 at a glance">
  <ul>
    {tiles.map(([value, label]) => <li><b>{value}</b><span>{label}</span></li>)}
  </ul>
</div>
