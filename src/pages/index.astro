const strings = [
  ["Nothing to sign up for", "The examples run in the browser without an account, and the framework is one abapGit pull."],
  ["Free to leave", "The apps stay plain ABAP classes, and the skill your team builds is ABAP. A build renamed into your own namespace is one workflow run."],
