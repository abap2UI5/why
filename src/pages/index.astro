            <text x="150" y="22" text-anchor="middle" class="dg-h us">abap2UI5</text>
            <rect x="60" y="38" width="180" height="48" rx="8" class="dg-box"/>
            <text x="150" y="58" text-anchor="middle" class="dg-t">Browser</text>
            <text x="150" y="76" text-anchor="middle" class="dg-s">shows the screen</text>
            <line x1="150" y1="92" x2="150" y2="112" class="dg-line" marker-start="url(#arch-a)" marker-end="url(#arch-a)"/>
            <rect x="24" y="118" width="252" height="184" rx="10" class="dg-us"/>
            <text x="150" y="142" text-anchor="middle" class="dg-t">Your SAP system</text>
            <rect x="44" y="154" width="212" height="38" rx="6" class="dg-box"/>
            <text x="150" y="178" text-anchor="middle" class="dg-t">The app: one ABAP class</text>
            <rect x="44" y="200" width="212" height="38" rx="6" class="dg-box"/>
            <text x="150" y="224" text-anchor="middle" class="dg-t">Business logic</text>
            <rect x="44" y="246" width="212" height="38" rx="6" class="dg-box"/>
            <text x="150" y="270" text-anchor="middle" class="dg-t">Data</text>

            <text x="475" y="22" text-anchor="middle" class="dg-h">Custom SAPUI5 app</text>
            <rect x="385" y="38" width="180" height="48" rx="8" class="dg-extra"/>
