/* What it costs: the lines a commercial platform bills, and what is left. */
const cost = [
  ["Framework license", "MIT, commercial use included, any number of users, systems and apps", "0"],
  ["Platform, runtime, hosting", "One service on the SAP system you already run", "0"],
  ["Support", "In the open, for anyone at any time; pull requests welcome", "0"],
