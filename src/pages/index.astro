/* What it costs: the lines a commercial platform bills, and what is left. */
const cost = [
  ["Framework license", "MIT, commercial use included, any number of users, systems and apps", "0"],
  ["Platform, runtime, hosting", "One service on the SAP system you already run; the UI5 your system already ships", "0"],
  ["Support", "Slack and GitHub issues, open to anyone at any time; pull requests welcome", "0"],
  ["Developer time", "An ABAP developer writes the screen, as for any class; this is the bill", "your rate"],
  ["Training and consulting", "Webinars, certification, app development by a consultancy, if wanted", "optional"],
