/* The market, as a manager compares it: abap2UI5, SAP's own two routes, and
 * the two kinds of commercial tool sold for building UI5 apps on SAP - the
 * low-code builder installed in the SAP system and the platform beside it.
 * No vendor is named: offers and prices change, a named comparison ages,
 * and the column describes what a reader would buy; `market` says what each
 * column stands for. A row where abap2UI5 is not ahead is marked `even`: it
 * gets a dash, not a tick. */
const rivals = ["RAP + Fiori Elements", "Custom SAPUI5 app", "Low-code builder in your SAP system", "Low-code platform beside SAP"];
const market = [
  ["RAP + Fiori Elements", "SAP's standard route: a list report or an object page generated from CDS annotations on a RAP service. Part of the SAP license, supported by SAP."],
  ["Custom SAPUI5 app", "A JavaScript project with its own OData service, built in Business Application Studio or VS Code and deployed to the system or to BTP. What a UI5 agency delivers."],
  ["Low-code builder in your SAP system", "A vendor's designer, installed as an add-on or a transport: screens are clicked together, stored in the vendor's tables and built into UI5 apps by its runtime. Licensed per user, device or developer. Several vendors sell one."],
  ["Low-code platform beside SAP", "A server or cloud tenant of its own, reaching SAP over connectors; built for citizen developers, SAP is one of many backends. General-purpose platforms and SAP's own no-code builder belong here."],
];
const compare = [
  ["License cost", "None: MIT, for any number of users, systems and apps", "Part of the SAP license", "Part of the SAP license", "Subscription per user, device or developer, often with a minimum term and a setup fee", "Subscription per user or app, plus the tenant"],
  ["Who builds the apps", "Your ABAP developers", "ABAP plus CDS, RAP and annotation skills", "JavaScript / UI5 developers", "The ABAP team, in the vendor's designer, after its training", "Citizen developers, or developers trained on the platform"],
