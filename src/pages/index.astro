/* The rows a decision turns on stay open; the rest fold under the table. */
const MAIN_ROWS = ["License cost", "Who builds the apps", "What an app is", "Where the business logic lives", "SAP releases", "Extra infrastructure and deployment", "Lock-in", "Support"];
const useIt = [
