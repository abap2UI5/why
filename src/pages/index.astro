 * gets a dash, not a tick. */
const rivals = ["RAP + Fiori Elements", "Custom SAPUI5 app", "Low-code builder in your SAP system", "Low-code platform beside SAP"];
const market = [
  ["RAP + Fiori Elements", "SAP's standard route: a list report or an object page generated from CDS annotations on a RAP service. Part of the SAP license, supported by SAP."],
